# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_optional_webhook_secret_here

# Exa.ai API Configuration
EXA_API_KEY=your_exa_api_key_here

# AI Provider Selection: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Polling & Webhook Configuration
POLLING_MODE=true
WEBHOOK_URL=https://your-domain.com
HOST=0.0.0.0
PORT=8000

# Scam Detection & Moderation Actions
RISK_THRESHOLD=0.7
BAN_THRESHOLD=0.85
AUTO_WARN=true
AUTO_BAN=true
AUTO_DELETE_SCAM_MESSAGE=true
